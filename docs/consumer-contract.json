{
  "packageName": "@condor/classic-ui",
  "privateGitDependency": "git+ssh://git@github.com/Apex-Business-Systems/condor-classic-ui.git#v0.1.1",
  "consumerPackageJsonRequirement": "Use immutable semantic tag or commit SHA only (no floating branch refs such as #main)",
  "consumerPackageJsonExample": {
    "@condor/classic-ui": "git+ssh://git@github.com/Apex-Business-Systems/condor-classic-ui.git#v0.1.1"
  },
  "assetBasePath": "/classic-stylesheets",
  "stylesheetExport": "@condor/classic-ui/styles.css",
  "themeProvider": "ClassicThemeProvider",
  "themes": [
    "cde",
    "macos9",
    "win3x",
    "win9x",
    "winxp"
  ],
  "defaultSkinsByTheme": {
    "cde": "default",
    "macos9": "default",
    "win3x": "3.1",
    "win9x": "95",
    "winxp": "default"
  },
  "requiredConsumerBehavior": [
    "Import @condor/classic-ui/styles.css once",
    "Use ClassicThemeProvider for theme and skin stylesheet links",
    "Do not duplicate CLASSIC_THEME_SKINS in consuming apps",
    "Serve classic-stylesheets assets at /classic-stylesheets",
    "Pin package installation to a semantic tag or commit SHA",
    "Treat skin stylesheet as optional: it is removed when skin is invalid or absent",
    "Enable persistPreferences only when localStorage writes are desired"
  ],
  "releasePolicy": {
    "tagFormat": "vMAJOR.MINOR.PATCH",
    "changelogRequired": true,
    "releaseProcessDoc": "docs/RELEASE_PROCESS.md"
  },
  "exportedSymbols": {
    "theme": [
      "CLASSIC_THEMES",
      "ClassicTheme",
      "CLASSIC_THEME_SKINS",
      "CLASSIC_DEFAULT_SKIN_BY_THEME",
      "ClassicSkin",
      "getSkinsForTheme",
      "getDefaultSkinForTheme",
      "isSkinValidForTheme",
      "ClassicThemeProviderProps",
      "ClassicThemeProvider"
    ],
    "controls": [
      "ClassicButtonProps",
      "ClassicButton",
      "ClassicInputProps",
      "ClassicInput",
      "ClassicTextareaProps",
      "ClassicTextarea",
      "ClassicSelectProps",
      "ClassicSelect",
      "ClassicFieldsetProps",
      "ClassicFieldset"
    ],
    "shell/layout": [
      "ClassicWindowProps",
      "ClassicWindow",
      "ClassicStatusBarProps",
      "ClassicStatusBar"
    ],
    "dialog": [],
    "table": []
  },
  "themeProviderLinkIds": {
    "theme": "classic-theme-link",
    "skin": "classic-skin-link"
  },
  "preferencePersistence": {
    "defaultPersistPreferences": false,
    "builtinStorageKeys": {
      "theme": "condor.classic.theme",
      "skin": "condor.classic.skin"
    },
    "supportsCustomStorageKeys": true
  }
}
