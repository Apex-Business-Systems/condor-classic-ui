{
  "name": "@condor/classic-ui",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "main": "./dist/condor-classic-ui.umd.cjs",
  "module": "./dist/condor-classic-ui.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "docs/consumer-contract.json"
  ],
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "classic-stylesheets": "^2.1.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "6.0.1",
    "eslint": "10.2.1",
    "jsdom": "29.0.2",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "typescript": "6.0.3",
    "vite": "8.0.10",
    "vite-plugin-dts": "4.5.4",
    "vitest": "4.0.7"
  },
  "style": "./dist/condor-classic-ui.css",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/condor-classic-ui.js",
      "require": "./dist/condor-classic-ui.umd.cjs"
    },
    "./styles.css": "./dist/condor-classic-ui.css",
    "./consumer-contract.json": "./docs/consumer-contract.json"
  },
  "packageManager": "npm@10.8.2",
  "engines": {
    "node": ">=20"
  }
}
